{
  "name": "@uniswap/uniswapx-service",
  "version": "0.1.0",
  "bin": {
    "app": "./dist/bin/app.js"
  },
  "license": "GPL",
  "type": "commonjs",
  "repository": "https://github.com/Uniswap/uniswapx-service",
  "resolutions": {
    "elliptic": "6.6.1"
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist cdk.out",
    "watch": "tsc -w",
    "test": "jest --selectProjects unit",
    "test:watch": "yarn test --watch",
    "test:integ": "jest --detectOpenHandles --forceExit --selectProjects integ",
    "test:e2e": "jest --detectOpenHandles --runInBand --selectProjects e2e",
    "cdk": "cdk",
    "fix": "run-s fix:*",
    "fix:prettier": "prettier \"lib/**/*.ts\" --write",
    "fix:lint": "eslint lib --ext .ts --fix",
    "lint": "eslint lib test --ext .ts",
    "coverage": "jest --detectOpenHandles --runInBand --forceExit --coverage --selectProjects unit integ"
  },
  "devDependencies": {
    "@shelf/jest-dynamodb": "^3.4.4",
    "@types/aws-lambda": "^8.10.108",
    "@types/bunyan": "^1.8.8",
    "@types/jest": "^29.2.0",
    "@types/lodash": "^4.14.195",
    "@types/node": "^20.14.8",
    "@types/uuid": "^8.3.4",
    "@typescript-eslint/eslint-plugin": "^5.40.1",
    "@typescript-eslint/parser": "^5.40.1",
    "esbuild": "^0.15.12",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-jest": "^27.9.0",
    "ethers": "^5.7.2",
    "jest": "^29.2.2",
    "jest-mock-extended": "^3.0.5",
    "lodash": "^4.17.21",
    "prettier": "^2.7.1",
    "prettier-plugin-organize-imports": "^3.1.1",
    "ts-node": "^10.9.1",
    "typescript": "5.5.4"
  },
  "dependencies": {
    "@aws-lambda-powertools/logger": "^1.18.0",
    "@aws-lambda-powertools/metrics": "^1.18.0",
    "@aws-sdk/client-dynamodb": "3.621.0",
    "@aws-sdk/client-kms": "^3.621.0",
    "@aws-sdk/client-s3": "^3.341.0",
    "@aws-sdk/client-sfn": "^3.341.0",
    "@aws-sdk/lib-dynamodb": "3.621.0",
    "@aws-sdk/node-http-handler": "3.341.0",
    "@smithy/node-http-handler": "^3.1.4",
    "@swc/core": "^1.3.101",
    "@swc/jest": "^0.2.29",
    "@uniswap/permit2-sdk": "^1.4.0",
    "@uniswap/sdk-core": "^7.20.0",
    "@uniswap/signer": "^0.0.4",
    "@uniswap/uniswapx-sdk": "3.1.0",
    "aws-cdk-lib": "2.268.0",
    "aws-embedded-metrics": "^4.1.0",
    "aws-sdk": "^2.1238.0",
    "axios": "^1.8.2",
    "bunyan": "^1.8.15",
    "constructs": "^10.5.0",
    "dotenv": "^16.0.3",
    "dynamodb-toolbox": "^0.5.0",
    "joi": "^17.7.0",
    "source-map-support": "^0.5.21",
    "uuid": "^9.0.0",
    "zod": "3"
  },
  "prettier": {
    "printWidth": 120,
    "semi": false,
    "singleQuote": true,
    "endOfLine": "lf",
    "insertFinalNewline": true
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
